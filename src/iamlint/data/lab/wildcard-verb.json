{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteEverythingIam",
      "Effect": "Allow",
      "Action": "iam:Create*",
      "Resource": "*"
    },
    {
      "Sid": "AnyRegionAnyAccount",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:*:123456789012:shared/*"
    }
  ]
}
